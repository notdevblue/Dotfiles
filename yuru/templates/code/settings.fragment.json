    "editorInfo.foreground": "@MINT@",
    "sideBar.background": "@BG@",
    "sideBar.foreground": "@FG@",
    "activityBar.background": "@BG@",
    "activityBar.foreground": "@MINT@",
    "statusBar.background": "@SURFACE@",
    "statusBar.foreground": "@FG@",
    "titleBar.activeBackground": "@BG@",
    "titleBar.activeForeground": "@FG@",
    "tab.activeBackground": "@SURFACE@",
    "tab.activeForeground": "@BRIGHT@",
    "tab.inactiveBackground": "@BG@",
    "tab.inactiveForeground": "@MUTED@",
    "panel.background": "@BG@",
    "terminal.background": "@BG@",
    "terminal.foreground": "@FG@",
    "terminalCursor.foreground": "@MINT@",
    "terminal.selectionBackground": "@BURGUNDY@",
    "input.background": "@SURFACE@",
    "input.foreground": "@FG@",
