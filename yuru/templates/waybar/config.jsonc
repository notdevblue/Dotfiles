{
    "layer": "bottom",
    "position": "bottom",
    "height": 26,
    "margin-left": 24,
    "margin-right": 24,
    "margin-bottom": 12,
    "spacing": 0,
    "modules-left": ["sway/workspaces"],
    "modules-center": [],
    "modules-right": ["group/tray-drawer", "group/service-drawer", "custom/codex", "custom/grok", "custom/yeelight", "pulseaudio#microphone", "clock"],
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{index}"
    },
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 0,
            "transition-left-to-right": false
        },
        "modules": ["group/tray-handle", "tray"]
    },
    "group/tray-handle": {
        "orientation": "horizontal",
        "modules": ["custom/tray", "custom/tray-open"]
    },
    "custom/tray-open": {
        "format": "&gt;",
        "tooltip": false
    },
    "custom/tray": {
        "format": "&lt;",
        "tooltip": false
    },
    "group/service-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 0,
            "transition-left-to-right": false
        },
        "modules": ["group/service-handle"]
    },
    "group/service-handle": {
        "orientation": "horizontal",
        "modules": ["custom/service", "custom/service-open"]
    },
    "custom/service-open": {
        "format": "-",
        "tooltip": false
    },
    "custom/service": {
        "format": "+",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/codex": {
        "exec": "python3 $HOME/.config/waybar/scripts/codex-usage.py",
        "return-type": "json",
        "interval": 60
    },
    "custom/grok": {
        "exec": "python3 $HOME/.config/waybar/scripts/grok-usage.py",
        "return-type": "json",
        "interval": 60
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": " ",
        "tooltip": false,
        "on-scroll-up": "true",
        "on-scroll-down": "true"
    },
    "custom/yeelight": {
        "tooltip": false,
        "exec": "python3 $HOME/.config/waybar/scripts/yeelight.py watch",
        "return-type": "json",
        "restart-interval": 3,
        "exec-on-event": false,
        "on-click": "python3 $HOME/.config/waybar/scripts/yeelight-popup.py 2>>$XDG_RUNTIME_DIR/yuru-yeelight-popup.log",
        "on-click-right": "python3 $HOME/.config/waybar/scripts/yeelight.py toggle",
        "on-scroll-up": "python3 $HOME/.config/waybar/scripts/yeelight.py adjust 5",
        "on-scroll-down": "python3 $HOME/.config/waybar/scripts/yeelight.py adjust -5",
        "smooth-scrolling-threshold": 0.1
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false
    }
}
