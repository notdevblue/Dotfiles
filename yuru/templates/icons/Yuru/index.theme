[Icon Theme]
Name=Yuru
Comment=Original geometric Yuru desktop icons
Inherits=Adwaita,AdwaitaLegacy,hicolor
Directories=scalable/places,scalable/mimetypes,scalable/apps,scalable/status,scalable/devices

[scalable/places]
Size=32
MinSize=16
MaxSize=256
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=32
MinSize=16
MaxSize=256
Type=Scalable
Context=MimeTypes

[scalable/apps]
Size=32
MinSize=16
MaxSize=256
Type=Scalable
Context=Applications

[scalable/status]
Size=32
MinSize=16
MaxSize=256
Type=Scalable
Context=Status

[scalable/devices]
Size=32
MinSize=16
MaxSize=256
Type=Scalable
Context=Devices
