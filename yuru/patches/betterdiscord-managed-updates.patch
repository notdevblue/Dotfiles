@@ -0,0 +1,15 @@
+import {repairDiscordHosts} from "../src/electron/main/migrator/repair";
+
+const args = process.argv.slice(2);
+if (args.length !== 2) {
+    console.error("Usage: repair-linux-host DISCORD_DATA_DIRECTORY ABSOLUTE_BETTERDISCORD_LOADER");
+    process.exitCode = 2;
+}
+else {
+    try {
+        const results = repairDiscordHosts(args[0], args[1]);
+        console.log(JSON.stringify(results));
+        if (results.some(result => result.status === "failed" || result.status === "preserved")) process.exitCode = 1;
+    }
+    catch (error) {console.error(String(error)); process.exitCode = 1;}
+}
