{
    "layer": "bottom",
    "position": "bottom",
    "height": 26,
    "margin-left": 24,
    "margin-right": 24,
    "margin-bottom": 12,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "group/tray-drawer",
        "group/service-drawer",
        "custom/yeelight",
        "custom/codex",
        "custom/grok",
        "pulseaudio#microphone",
        "clock"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{index}"
    },
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 0,
            "transition-left-to-right": false
        },
        "modules": [
            "group/tray-handle",
            "tray"
        ]
    },
    "group/tray-handle": {
        "orientation": "horizontal",
        "modules": [
            "custom/tray",
            "custom/tray-open"
        ]
    },
    "custom/tray-open": {
        "format": "&gt;",
        "tooltip": false
    },
    "custom/tray": {
        "format": "&lt;",
        "tooltip": false
    },
    "group/service-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 0,
            "transition-left-to-right": false
        },
        "modules": [
            "group/service-handle",
            "custom/forge",
            "custom/chat",
            "custom/ppwork"
        ]
    },
    "group/service-handle": {
        "orientation": "horizontal",
        "modules": [
            "custom/service",
            "custom/service-open"
        ]
    },
    "custom/service-open": {
        "format": "-",
        "tooltip": false
    },
    "custom/service": {
        "format": "+",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/codex": {
        "exec": "python3 $HOME/.config/waybar/scripts/codex-usage.py",
        "return-type": "json",
        "interval": 60
    },
    "custom/grok": {
        "exec": "python3 $HOME/.config/waybar/scripts/grok-usage.py",
        "return-type": "json",
        "interval": 60
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": " ",
        "tooltip": false,
        "on-scroll-up": "true",
        "on-scroll-down": "true"
    },
    "custom/yeelight": {
        "exec": "python3 $HOME/.config/waybar/scripts/yeelight.py watch",
        "return-type": "json",
        "restart-interval": 3,
        "exec-on-event": false,
        "on-click": "python3 $HOME/.config/waybar/scripts/yeelight.py toggle",
        "on-click-right": "python3 $HOME/.config/waybar/scripts/yeelight-popup.py",
        "on-scroll-up": "python3 $HOME/.config/waybar/scripts/yeelight.py adjust 5",
        "on-scroll-down": "python3 $HOME/.config/waybar/scripts/yeelight.py adjust -5",
        "smooth-scrolling-threshold": 5
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "custom/forge": {
        "exec": "python3 $HOME/.config/waybar/scripts/service-toggle.py forge",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "exec-on-event": false,
        "on-click": "python3 $HOME/.config/waybar/scripts/service-toggle.py forge toggle"
    },
    "custom/chat": {
        "exec": "python3 $HOME/.config/waybar/scripts/service-toggle.py chat",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "exec-on-event": false,
        "on-click": "python3 $HOME/.config/waybar/scripts/service-toggle.py chat toggle"
    },
    "custom/ppwork": {
        "exec": "python3 $HOME/.config/waybar/scripts/service-toggle.py ppwork",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "exec-on-event": false,
        "on-click": "python3 $HOME/.config/waybar/scripts/service-toggle.py ppwork toggle"
    }
}
