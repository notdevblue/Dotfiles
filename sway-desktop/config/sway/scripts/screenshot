#!/usr/bin/env python3
"""Capture the invocation frame, save an sRGB PNG, and copy it for sharing."""
import fcntl
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time


def ipc(kind):
    return json.loads(subprocess.check_output(["swaymsg", "-r", "-t", kind], timeout=3))


def focused_window(node):
    if node.get("focused") and (node.get("app_id") or node.get("window") or node.get("pid")):
        return node
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = focused_window(child)
        if found is not None:
            return found
    return None


def interrupted(signum, frame):
    raise SystemExit(128 + signum)


def grid_socket():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        return None
    path = Path(runtime) / "sway-screenshot-grid.sock"
    return path if path.exists() else None


def grid_call(command, timeout):
    """Ask the composition grid to hide or return. Absence is not an error."""
    path = grid_socket()
    if path is None:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(timeout)
            client.connect(str(path))
            client.sendall(command.encode() + b"\n")
            data = bytearray()
            while b"\n" not in data:
                chunk = client.recv(128)
                if not chunk:
                    break
                data.extend(chunk)
        return bytes(data).split(b"\n", 1)[0].decode().strip()
    except (OSError, UnicodeError):
        return None


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "region"
    if mode not in ("region", "window", "full", "raw-output"):
        raise SystemExit(2)
    if mode == "raw-output" and len(sys.argv) != 3:
        sys.exit("Usage: screenshot raw-output OUTPUT")
    lock = None
    if mode == "region":
        lock = open(Path(os.environ["XDG_RUNTIME_DIR"]) / "sway-screenshot-region.lock", "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
    binary = Path.home() / ".local/lib/grim-freeze/grim"
    arguments = [str(binary)]
    # wlr/ext capture currently returns Sway's output encoding. Normalize each
    # HDR source before the client joins outputs with different encodings.
    for output in ipc("get_outputs"):
        if output.get("active") and output.get("power", True) and output.get("hdr"):
            white = float(output.get("sdr_white_level", 203))
            if not 1 <= white <= 10000:
                raise RuntimeError("Invalid output reference white")
            arguments += ["-H", f'{output["name"]}={white:g}']
    if mode == "window":
        window = focused_window(ipc("get_tree"))
        if window is None:
            raise RuntimeError("No focused window to capture")
        rect, content = window["rect"], window["window_rect"]
        if content["width"] <= 0 or content["height"] <= 0:
            raise RuntimeError("Focused window has no visible content")
        arguments += ["-g", f'{rect["x"] + content["x"]},{rect["y"] + content["y"]} '
                           f'{content["width"]}x{content["height"]}']
    elif mode == "region":
        arguments += ["-f"]
    elif mode == "raw-output":
        arguments += ["-r", "-o", sys.argv[2]]
    directory = Path.home() / "Pictures/Screenshots"
    directory.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    destination = directory / f"{stamp}-{time.time_ns() % 1000000000:09d}{'-HDR-original' if mode == 'raw-output' else ''}.png"
    capture = None
    # The grid is part of the composited output until a later frame replaces it.
    hide_grid = grid_socket() is not None
    try:
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, interrupted)
        if hide_grid:
            grid_call("pause", 2)
        # No -c: the shared capture client hides an already-composited cursor
        # before copying, then selects and crops those same original buffers.
        capture = subprocess.Popen(arguments + [str(destination)], close_fds=True)
        status = capture.wait()
        if status == 2 and mode == "region":
            return
        if status:
            raise RuntimeError("Screen capture failed")
    finally:
        if capture is not None and capture.poll() is None:
            capture.terminate()
            try:
                capture.wait(timeout=3)
            except subprocess.TimeoutExpired:
                capture.kill()
                capture.wait()
        if hide_grid:
            grid_call("resume", 1)
        if lock is not None:
            lock.close()
    if mode == "raw-output":
        title = "Screenshot original saved"
    else:
        with destination.open("rb") as image:
            subprocess.run(["wl-copy", "--type", "image/png"], stdin=image, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        title = "Screenshot saved and copied"
    subprocess.run(["notify-send", "-i", str(destination), title, str(destination)], check=False)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"Screenshot failed: {error}", file=sys.stderr)
        sys.exit(1)
