#!/usr/bin/env python3
"""Switch all displays off together, or restore them if any display is off."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    with (runtime / "sway-display-power.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        reply = subprocess.run(
            ["swaymsg", "-r", "-t", "get_outputs"], capture_output=True,
            text=True, check=True, timeout=5)
        outputs = [output for output in json.loads(reply.stdout)
                   if output.get("active")]
        if not outputs:
            return
        # Reading live state avoids stale counters after reconnects or manual
        # power changes. A mixed state always recovers to all displays on.
        power = "off" if all(output["power"] for output in outputs) else "on"
        reply = subprocess.run(
            ["swaymsg", "-r", f"output * power {power}"], capture_output=True,
            text=True, check=True, timeout=5)
        if not all(item.get("success") for item in json.loads(reply.stdout)):
            raise RuntimeError("Sway could not update display power")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError,
            RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
