#!/usr/bin/python3
"""Toggle a camera rule-of-thirds grid over the focused window.

Super+PrintScreen toggles it. The grid is click-through and is removed from
the presented output before grim copies a screenshot, then restored.
"""
import fcntl
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import threading
import time

SOCKET_NAME = "sway-screenshot-grid.sock"
LOCK_NAME = "sway-screenshot-grid.lock"


def runtime_path(name):
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        raise RuntimeError("XDG_RUNTIME_DIR이 없습니다")
    return Path(runtime) / name


def transact(command, timeout):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        client.connect(str(runtime_path(SOCKET_NAME)))
        client.sendall(command.encode() + b"\n")
        data = bytearray()
        while b"\n" not in data:
            chunk = client.recv(128)
            if not chunk:
                break
            data.extend(chunk)
    finally:
        client.close()
    return bytes(data).split(b"\n", 1)[0].decode().strip()


def socket_responds():
    try:
        return transact("status", 0.2) in ("on", "off")
    except OSError:
        return False


def ensure_daemon():
    with runtime_path(LOCK_NAME).open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if socket_responds():
            return
        runtime_path(SOCKET_NAME).unlink(missing_ok=True)
        log = runtime_path("sway-screenshot-grid.log").open("ab", buffering=0)
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--daemon"],
            stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
            start_new_session=True, close_fds=True)
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            if socket_responds():
                return
            time.sleep(0.02)
        raise RuntimeError("격자 오버레이를 시작하지 못했습니다")


def run_client(command):
    if command == "toggle":
        ensure_daemon()
        reply = transact("toggle", 2)
        if reply not in ("on", "off"):
            raise RuntimeError("격자 오버레이가 응답하지 않습니다")
        print(reply)
        return
    if command == "status" and not socket_responds():
        print("off")
        return
    if command in ("pause", "resume") and not runtime_path(SOCKET_NAME).exists():
        return
    timeout = 2 if command == "pause" else 1
    reply = transact(command, timeout)
    if command == "status":
        print(reply or "off")


def focused_window(con):
    if con.focused and (con.app_id or con.window or con.pid):
        if con.app_id != "screenshot-grid":
            return con
    for child in con.nodes + con.floating_nodes:
        found = focused_window(child)
        if found is not None:
            return found
    return None


def content_box(con):
    rect, content = con.rect, con.window_rect
    if content is None or content.width <= 0 or content.height <= 0:
        return None
    return (rect.x + content.x, rect.y + content.y, content.width, content.height)


def guide_origins(span):
    if span < 6:
        return []
    origins = []
    for numerator in (1, 2):
        center = int(round(span * numerator / 3))
        origins.append(max(0, min(span - 2, center - 1)))
    return origins


class GridOverlay:
    def __init__(self):
        import cairo
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import Gdk, GLib, Gtk, GtkLayerShell
        import i3ipc

        self.cairo = cairo
        self.Gdk = Gdk
        self.GLib = GLib
        self.Gtk = Gtk
        self.Layer = GtkLayerShell
        self.enabled = False
        self.suspended = False
        self.hiding = False
        self.depth = 0
        self.rect = None
        self._monitor_key = None
        self._shown = None
        self._waiters = []
        self._committed = False
        self._tick_id = None
        self._timeout_id = None
        self._painted = []
        self._presented = []
        self._ipc = i3ipc.Connection()
        self.window = self._create_window()
        GLib.timeout_add(200, self._poll)
        threading.Thread(target=self._events, args=(i3ipc, GLib), daemon=True).start()

    def _create_window(self):
        Gtk, Gdk, Layer = self.Gtk, self.Gdk, self.Layer
        window = Gtk.Window()
        window.set_decorated(False)
        window.set_app_paintable(True)
        window.set_accept_focus(False)
        window.set_focus_on_map(False)
        window.set_skip_taskbar_hint(True)
        window.set_skip_pager_hint(True)
        visual = window.get_screen().get_rgba_visual()
        if visual is not None:
            window.set_visual(visual)
        provider = Gtk.CssProvider()
        provider.load_from_data(b"* { background-color: transparent; background-image: none; }")
        Gtk.StyleContext.add_provider_for_screen(
            window.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Layer.init_for_window(window)
        Layer.set_layer(window, Layer.Layer.OVERLAY)
        Layer.set_namespace(window, "screenshot-grid")
        for edge in (Layer.Edge.TOP, Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT):
            Layer.set_anchor(window, edge, True)
        Layer.set_exclusive_zone(window, -1)
        Layer.set_keyboard_mode(window, Layer.KeyboardMode.NONE)
        window.connect("draw", self._draw)
        window.connect("realize", lambda *_args: self._pass_through())
        window.connect("map-event", lambda *_args: self._pass_through())
        window.connect("size-allocate", self._resized)
        return window

    def _pass_through(self):
        region = self.cairo.Region()
        self.window.input_shape_combine_region(region)
        gdk_window = self.window.get_window()
        if gdk_window is not None:
            gdk_window.input_shape_combine_region(region, 0, 0)
            gdk_window.set_opaque_region(self.cairo.Region())
        return False

    def _resized(self, *_args):
        self._pass_through()
        if self.enabled and not self.suspended and not self.hiding:
            self.window.queue_draw()
        return False

    def _events(self, i3ipc, glib):
        try:
            conn = i3ipc.Connection()
            conn.on("window", lambda *_args: glib.idle_add(self.refresh))
            conn.on("workspace", lambda *_args: glib.idle_add(self.refresh))
            conn.on("output", lambda *_args: glib.idle_add(self.refresh))
            conn.on("shutdown", lambda *_args: glib.idle_add(self.Gtk.main_quit))
            conn.main()
        except Exception as error:
            print(f"sway events stopped: {error}", flush=True)
            glib.idle_add(self.Gtk.main_quit)

    def _poll(self):
        self.refresh()
        return True

    def refresh(self):
        if not self.enabled or self.depth or self.hiding or self.suspended:
            return False
        try:
            con = focused_window(self._ipc.get_tree())
        except OSError as error:
            print(f"sway ipc failed: {error}", flush=True)
            return False
        box = content_box(con) if con is not None else None
        monitor, geo = self._monitor_for(box) if box is not None else (None, None)
        if monitor is None:
            self.rect = None
            self._shown = None
            if self.window.get_visible():
                self.window.hide()
            return False
        local = (box[0] - geo.x, box[1] - geo.y, box[2], box[3])
        key = (geo.x, geo.y, geo.width, geo.height, local)
        if key == self._shown and self.window.get_visible():
            return False
        self.rect = local
        self._shown = key
        monitor_key = key[:4]
        if monitor_key != self._monitor_key:
            self.Layer.set_monitor(self.window, monitor)
            self._monitor_key = monitor_key
        self.window.set_size_request(geo.width, geo.height)
        if not self.window.get_visible():
            self.window.show_all()
        self._pass_through()
        self.window.queue_draw()
        print(f"grid {local[2]}x{local[3]} at {local[0]},{local[1]} "
              f"alloc {self.window.get_allocated_width()}x{self.window.get_allocated_height()}",
              flush=True)
        return False

    def _monitor_for(self, box):
        x, y, width, height = box
        cx, cy = x + width / 2, y + height / 2
        display = self.Gdk.Display.get_default()
        for index in range(display.get_n_monitors()):
            monitor = display.get_monitor(index)
            geo = monitor.get_geometry()
            if geo.x <= cx < geo.x + geo.width and geo.y <= cy < geo.y + geo.height:
                return monitor, geo
        return None, None

    def _draw(self, _widget, cr):
        cr.set_operator(self.cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(self.cairo.OPERATOR_OVER)
        if self.suspended or not self.enabled or self.rect is None:
            return True
        x, y, width, height = self.rect
        cr.set_antialias(self.cairo.ANTIALIAS_NONE)
        cr.save()
        cr.rectangle(x, y, width, height)
        cr.clip()
        for origin in guide_origins(width):
            self._fill(cr, x + origin, y, 1, height, 0, 0, 0, 0.75)
            self._fill(cr, x + origin + 1, y, 1, height, 1, 1, 1, 0.92)
        for origin in guide_origins(height):
            self._fill(cr, x, y + origin, width, 1, 0, 0, 0, 0.75)
            self._fill(cr, x, y + origin + 1, width, 1, 1, 1, 1, 0.92)
        cr.restore()
        return True

    def _fill(self, cr, x, y, width, height, red, green, blue, alpha):
        cr.set_source_rgba(red, green, blue, alpha)
        cr.rectangle(x, y, width, height)
        cr.fill()

    def toggle(self):
        self.enabled = not self.enabled
        if not self.enabled:
            self.rect = None
            self._shown = None
            if self.depth == 0:
                self.suspended = False
            self.window.hide()
            print("grid off", flush=True)
            return False
        if self.depth == 0 and not self.hiding:
            self.suspended = False
            self._shown = None
            self.refresh()
        print("grid on", flush=True)
        return True

    def pause(self, done):
        self.depth += 1
        if self.hiding:
            self._waiters.append(done)
            return
        if not self.window.get_mapped():
            done()
            return
        self.hiding = True
        self.suspended = True
        self._shown = None
        self._waiters.append(done)
        self._begin_capture_wait()

    def resume(self):
        if self.depth > 0:
            self.depth -= 1
        if self.hiding or self.depth > 0:
            return
        self.suspended = False
        if self.enabled:
            self._shown = None
            self.refresh()
        elif self.window.get_visible():
            self.window.hide()

    def _begin_capture_wait(self):
        # Capture reads the latest presented buffer, so the lines have to be
        # gone from a completed frame before grim is allowed to start.
        self._committed = False
        self._painted = []
        self._presented = []
        self._ticks = 0
        self.window.queue_draw()
        if self.window.get_frame_clock() is None:
            self.GLib.idle_add(self._commit_hidden)
            return
        self._tick_id = self.window.add_tick_callback(self._capture_tick)
        self._timeout_id = self.GLib.timeout_add(200, self._capture_timeout)

    def _capture_tick(self, widget, clock):
        frame = clock.get_frame_counter()
        self._painted.append(frame)
        self._ticks += 1
        for painted in self._painted:
            timings = clock.get_timings(painted)
            if timings is None or not timings.get_complete():
                continue
            stamp = timings.get_presentation_time()
            if stamp and stamp not in self._presented:
                self._presented.append(stamp)
        ready = self._ticks >= 2 and (len(self._presented) >= 2 or self._ticks >= 4)
        if ready:
            self._tick_id = None
            self.GLib.idle_add(self._commit_hidden)
            return self.GLib.SOURCE_REMOVE
        widget.queue_draw()
        return self.GLib.SOURCE_CONTINUE

    def _capture_timeout(self):
        self._timeout_id = None
        if self._tick_id is not None:
            self.window.remove_tick_callback(self._tick_id)
            self._tick_id = None
        self._commit_hidden()
        return self.GLib.SOURCE_REMOVE

    def _commit_hidden(self):
        if self._committed or not self.hiding:
            return False
        self._committed = True
        if self._timeout_id is not None:
            self.GLib.source_remove(self._timeout_id)
            self._timeout_id = None
        self.window.hide()
        display = self.Gdk.Display.get_default()
        if display is not None:
            display.sync()
        if len(self._presented) >= 2:
            period = self._presented[-1] - self._presented[-2]
        else:
            period = self._output_period_us()
        period = min(max(int(period), 4000), 40000)
        delay = max(0.02, (period * 2) / 1_000_000)
        print(f"capture wait ticks={self._ticks} presented={len(self._presented)} "
              f"sleep_ms={delay * 1000:.0f}", flush=True)
        time.sleep(delay)
        self.hiding = False
        waiters, self._waiters = self._waiters, []
        for done in waiters:
            done()
        return False

    def _output_period_us(self):
        try:
            for output in self._ipc.get_outputs():
                mode = output.current_mode
                if output.focused and mode is not None and mode.refresh:
                    hz = mode.refresh / 1000
                    if 20 <= hz <= 1000:
                        return int(1_000_000 / hz)
        except OSError:
            pass
        return 16000


class Server:
    def __init__(self, grid):
        self.grid = grid
        self.path = runtime_path(SOCKET_NAME)
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(str(self.path))
        os.chmod(self.path, 0o600)
        self.sock.listen(8)
        self.sock.setblocking(False)
        self.grid.GLib.io_add_watch(self.sock.fileno(), self.grid.GLib.IO_IN, self._accept)

    def close(self):
        self.sock.close()
        self.path.unlink(missing_ok=True)

    def _accept(self, _fd, _cond):
        while True:
            try:
                conn, _addr = self.sock.accept()
            except BlockingIOError:
                return True
            conn.setblocking(False)
            self._listen(conn, bytearray())
        return True

    def _listen(self, conn, buf):
        def on_input(_fd, cond):
            glib = self.grid.GLib
            if cond & (glib.IO_HUP | glib.IO_ERR | glib.IO_NVAL):
                conn.close()
                return False
            try:
                data = conn.recv(256)
            except BlockingIOError:
                return True
            if not data:
                conn.close()
                return False
            buf.extend(data)
            if b"\n" not in buf:
                return True
            command = bytes(buf).split(b"\n", 1)[0].decode().strip()
            self._dispatch(conn, command)
            return False

        self.grid.GLib.io_add_watch(
            conn.fileno(), self.grid.GLib.IO_IN | self.grid.GLib.IO_HUP, on_input)

    def _dispatch(self, conn, command):
        grid = self.grid
        if command == "toggle":
            self._reply(conn, "on" if grid.toggle() else "off")
        elif command == "status":
            self._reply(conn, "on" if grid.enabled else "off")
        elif command == "pause":
            grid.pause(lambda conn=conn: self._reply(conn, "paused"))
        elif command == "resume":
            grid.resume()
            self._reply(conn, "resumed")
        elif command == "quit":
            self._reply(conn, "bye")
            grid.Gtk.main_quit()
        else:
            self._reply(conn, "error")

    def _reply(self, conn, text):
        try:
            conn.setblocking(True)
            conn.sendall((text + "\n").encode())
        except OSError:
            pass
        conn.close()


def run_daemon():
    os.environ["GDK_BACKEND"] = "wayland"
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk
    GLib.set_prgname("screenshot-grid")
    Gtk.init([])
    grid = GridOverlay()
    server = Server(grid)

    def stop():
        Gtk.main_quit()
        return GLib.SOURCE_REMOVE

    def handle_stop(_signum, _frame):
        GLib.idle_add(stop)

    signal.signal(signal.SIGTERM, handle_stop)
    signal.signal(signal.SIGINT, handle_stop)
    try:
        Gtk.main()
    finally:
        server.close()


def main():
    if sys.argv[1:] == ["--daemon"]:
        try:
            run_daemon()
        except Exception as error:
            print(f"screenshot grid failed: {error}", file=sys.stderr)
            sys.exit(1)
        return
    if len(sys.argv) != 2 or sys.argv[1] not in ("toggle", "status", "pause", "resume", "quit"):
        sys.exit("Usage: screenshot-grid toggle|status|pause|resume|quit")
    try:
        run_client(sys.argv[1])
    except (OSError, RuntimeError, UnicodeError) as error:
        print(str(error), file=sys.stderr)
        if sys.argv[1] == "toggle":
            subprocess.run(["notify-send", "격자 오버레이", str(error)], check=False)
        sys.exit(1)


if __name__ == "__main__":
    main()
