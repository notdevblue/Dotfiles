#!/bin/sh
# BEGIN yuru-theme
if [ -n "${QT_QPA_PLATFORMTHEME:-}" ]; then
    dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME
fi
# END yuru-theme
# Make portals and D-Bus activated apps inherit the running Sway session.
dbus-update-activation-environment --systemd \
    DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE XMODIFIERS QT_IM_MODULE SDL_IM_MODULE
# Refresh a portal that may have started before Sway exported its display.
systemctl --user try-restart xdg-desktop-portal.service
systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service
fcitx5 -d
# Keep the HID++ connection open and recover wheel resolution after reconnects.
systemctl --user start g502-wheel-guard.service
dunst &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
"$HOME/.config/sway/scripts/idle" &
# Start the recorder after the session environment and audio services are ready.
# launch-daemon keeps the overlay hidden and avoids duplicate instances.
if command -v gsr-ui >/dev/null 2>&1; then
    gsr-ui launch-daemon &
fi
