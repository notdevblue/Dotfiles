#!/usr/bin/env python3
"""Change only keyboard repeat for game focus; never configure pointing devices."""
import fcntl
import json
import os
from pathlib import Path
import signal

import i3ipc

RELOAD_TICK = "game-input-guard:reload"


def input_config():
    path = Path.home() / ".config/sway/game-input.json"
    return json.loads(path.read_text()) if path.exists() else {}


def is_game(window):
    if window is None:
        return False
    if f"_game_input_off_{window.id}" in window.marks:
        return False
    if f"_game_input_on_{window.id}" in window.marks:
        return True
    config = input_config()
    app_id = (window.app_id or "").lower()
    window_class = (window.window_class or "").lower()
    if any(value.startswith("steam_app_") or value == "gamescope"
           for value in (app_id, window_class)):
        return True
    if app_id in config.get("app_ids", []) or window_class in config.get("classes", []):
        return True
    # Native Steam games do not always have a steam_app_* window identifier.
    try:
        environment = Path(f"/proc/{window.pid}/environ").read_bytes().split(b"\0")
        return any(entry.startswith(b"SteamAppId=") and
                   entry.partition(b"=")[2].isdigit() and
                   int(entry.partition(b"=")[2]) > 0 for entry in environment)
    except (OSError, TypeError):
        return False


def main():
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    with (runtime / "game-input-guard.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            i3ipc.Connection().send_tick(RELOAD_TICK)
            return
        ipc = i3ipc.Connection()
        applied_rate = None

        def set_rate(rate):
            # Some devices expose a keyboard and pointer with the same ID.
            # Selecting type:keyboard avoids reconfiguring their pointer side.
            replies = ipc.command(f"input type:keyboard repeat_rate {rate}")
            if not all(reply.success for reply in replies):
                raise RuntimeError("Could not set keyboard repeat")

        def sync(*_):
            nonlocal applied_rate
            rate = 0 if is_game(ipc.get_tree().find_focused()) else 25
            if rate != applied_rate:
                set_rate(rate)
                applied_rate = rate

        def on_focus(_, event):
            if event.change in ("focus", "close"):
                sync()

        def on_tick(_, event):
            nonlocal applied_rate
            if event.payload == RELOAD_TICK:
                applied_rate = None
                sync()

        ipc.on(i3ipc.Event.WINDOW, on_focus)
        ipc.on(i3ipc.Event.WORKSPACE, on_focus)
        ipc.on(i3ipc.Event.TICK, on_tick)
        ipc.on(i3ipc.Event.SHUTDOWN, lambda *_: ipc.main_quit())
        for sig in (signal.SIGINT, signal.SIGTERM):
            signal.signal(sig, lambda *_: ipc.main_quit())
        try:
            sync()
            ipc.main()
        finally:
            # A stopped helper should leave ordinary desktop typing intact.
            try:
                set_rate(25)
            except Exception:
                # The compositor may already have closed its IPC socket.
                pass


if __name__ == "__main__":
    main()
