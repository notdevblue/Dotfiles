# Yuru colors; existing notification behavior and DP-5 placement retained.
[global]
    monitor = DP-5
    follow = none
    width = 320
    height = (0, 300)
    origin = bottom-left
    offset = (10, 10)
    notification_limit = 5
    font = Ubuntu Mono 12
    format = "<b>%s</b>\n%b"
    markup = full
    padding = 10
    horizontal_padding = 10
    frame_width = 1
    frame_color = "#A69A9F"
    separator_color = frame
    gap_size = 5
    corner_radius = 0
    icon_position = off
    icon_theme = Adwaita
    min_icon_size = 24
    max_icon_size = 48
    dmenu = rofi -dmenu -p dunst
    browser = xdg-open
    force_xwayland = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1E191F"
    foreground = "#E1DBD1"
    timeout = 5

[urgency_normal]
    background = "#1E191F"
    foreground = "#E1DBD1"
    timeout = 10

[urgency_critical]
    background = "#1E191F"
    foreground = "#EAECF0"
    frame_color = "#712F3E"
    timeout = 0
