#!/usr/bin/env python3
"""Live SDR brightness slider for the saved Sway HDR profile."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

PROFILE = Path.home() / '.config/sway-hdr.conf'
TITLE = 'SDR 화면 밝기'


def ipc(*args):
    result = subprocess.run(['swaymsg', '-r', *args], capture_output=True,
                            text=True, timeout=3, check=True)
    return json.loads(result.stdout)


def output():
    outputs = [o for o in ipc('-t', 'get_outputs')
               if o.get('active') and o.get('hdr') and 'sdr_white_level' in o]
    if not outputs:
        raise RuntimeError('HDR이 켜진 화면을 찾지 못했습니다.')
    return next((o for o in outputs if o.get('focused')), outputs[0])


def apply(name, value):
    if not 1 <= value <= 1000:
        raise ValueError('밝기는 1~1000 사이여야 합니다.')
    current = next((o for o in ipc('-t', 'get_outputs') if o['name'] == name), {})
    if not current.get('hdr'):
        raise RuntimeError('HDR 출력이 꺼져 있습니다.')
    original = PROFILE.read_text()
    updated, count = re.subn(r'(?m)^(\s*sdr_white_level\s+)\S+(\s*)$',
                            lambda m: m[1] + str(value) + m[2], original)
    if count != 1:
        raise RuntimeError('저장된 HDR 밝기 설정을 찾지 못했습니다.')
    answer = ipc(f'output {json.dumps(name)} sdr_white_level {value}')
    if not all(row.get('success') for row in answer):
        raise RuntimeError('화면 밝기를 적용하지 못했습니다.')
    # Atomic replacement keeps startup configuration valid during slider drags.
    fd, temporary = tempfile.mkstemp(prefix='.sdr-brightness-', dir=PROFILE.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(updated)
        os.chmod(temporary, PROFILE.stat().st_mode & 0o777)
        os.replace(temporary, PROFILE)
    finally:
        Path(temporary).unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--set', type=int, metavar='NITS')
    parser.add_argument('--status', action='store_true')
    args = parser.parse_args()
    display = output()
    if args.status:
        print(json.dumps({k: display[k] for k in
              ('name', 'model', 'hdr', 'sdr_white_level')}, ensure_ascii=False))
        return
    if args.set is not None:
        apply(display['name'], args.set)
        return
    initial = round(display['sdr_white_level'])
    child = subprocess.Popen(['zenity', '--scale', '--title=' + TITLE,
        '--text=일반 화면 밝기 · nit\n움직이면 즉시 적용되고 다음 로그인에도 유지됩니다.',
        '--width=520', '--value=' + str(initial), '--min-value=1',
        '--max-value=1000', '--step=1', '--print-partial',
        '--ok-label=닫기', '--cancel-label=되돌리기'],
        stdout=subprocess.PIPE, text=True)
    try:
        for line in child.stdout:
            apply(display['name'], int(line.strip()))
        if child.wait() != 0:
            apply(display['name'], initial)
    finally:
        if child.poll() is None:
            child.terminate()
            child.wait()


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        if len(sys.argv) == 1:
            subprocess.run(['zenity', '--error', '--title=' + TITLE,
                            '--text=' + str(error)], check=False)
        sys.exit(1)
