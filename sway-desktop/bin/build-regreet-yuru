#!/bin/sh
# Keep the packaged ReGreet; build only a pinned presentation-layer variant.
set -eu
commit=290e6f8d65b7034c5b63bc950a20bcf8277ebe5f
script_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/regreet-yuru
mkdir -p "$cache"
build_dir=$(mktemp -d "$cache/src.XXXXXX")
trap 'rm -rf -- "$build_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
git init -q "$build_dir"
git -C "$build_dir" remote add origin https://github.com/rharish101/ReGreet.git
git -C "$build_dir" fetch --depth 1 origin "$commit"
git -C "$build_dir" checkout --detach -q FETCH_HEAD
test "$(git -C "$build_dir" rev-parse HEAD)" = "$commit"
git -C "$build_dir" apply "$script_dir/../patches/regreet-lock-layout.patch"
CARGO_TARGET_DIR="$cache/target" CARGO_BUILD_JOBS="${REGREET_BUILD_JOBS:-8}" \
    cargo build --locked --release --manifest-path "$build_dir/Cargo.toml"
target_dir="$HOME/.local/lib/regreet-yuru"
mkdir -p "$target_dir"
install -m755 "$cache/target/release/regreet" "$target_dir/regreet.new"
mv -f "$target_dir/regreet.new" "$target_dir/regreet"
echo "Built $target_dir/regreet; run sway-desktop/bin/install-greetd to apply."
