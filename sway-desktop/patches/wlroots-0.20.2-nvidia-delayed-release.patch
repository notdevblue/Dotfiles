+static void drm_plane_release_previous(struct wlr_drm_plane *plane) {
+	drm_fb_clear(&plane->previous_fb);
+	if (plane->previous_release_timeline != NULL) {
+		wlr_drm_syncobj_timeline_signal(plane->previous_release_timeline,
+			plane->previous_release_point);
+		wlr_drm_syncobj_timeline_unref(plane->previous_release_timeline);
+		plane->previous_release_timeline = NULL;
+		plane->previous_release_point = 0;
+	}
+}
+
+static void drm_plane_finish_page_flip(struct wlr_drm_plane *plane, bool delayed_release) {
+	if (plane->queued_fb == NULL) {
+		return;
+	}
+
+	drm_plane_release_previous(plane);
+	if (delayed_release) {
+		drm_fb_move(&plane->previous_fb, &plane->current_fb);
+		plane->previous_release_timeline = plane->current_release_timeline;
+		plane->previous_release_point = plane->current_release_point;
+	}
+	drm_fb_move(&plane->current_fb, &plane->queued_fb);
+	if (!delayed_release && plane->current_release_timeline != NULL) {
+		wlr_drm_syncobj_timeline_signal(plane->current_release_timeline,
+			plane->current_release_point);
+		wlr_drm_syncobj_timeline_unref(plane->current_release_timeline);
+	}
+	plane->current_release_timeline = plane->queued_release_timeline;
+	plane->current_release_point = plane->queued_release_point;
+	plane->queued_release_timeline = NULL;
+	plane->queued_release_point = 0;
+}
