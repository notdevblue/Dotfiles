diff --git a/render/vulkan/blur.c b/render/vulkan/blur.c
new file mode 100644
index 0000000..450c01a
--- /dev/null
+++ b/render/vulkan/blur.c
@@ -0,0 +1,307 @@
+#include <assert.h>
+#include <stdlib.h>
+#include "render/vulkan.h"
+#include "blur.comp.h"
+
+/* Keep effects in the renderer's existing FP16 scene-prefix submission.
+ * Aqueous's render-seam design informed the suspend/resume architecture:
+ * https://github.com/Seafoam-Labs/Aqueous/blob/e32ab7fc8f6510b393780b811ef92fe1bac6438e/docs/architecture-decisions/0001-vulkan-render-seam.md
+ * The Gaussian shader and Vulkan pipeline here are original local code. */
+
+void vulkan_blur_finish(struct wlr_vk_renderer *renderer) {
+	VkDevice dev = renderer->dev->dev;
+	vkDestroyPipeline(dev, renderer->blur_pipeline, NULL);
+	vkDestroyPipelineLayout(dev, renderer->blur_layout, NULL);
+	vkDestroyDescriptorSetLayout(dev, renderer->blur_ds_layout, NULL);
+	vkDestroySampler(dev, renderer->blur_sampler, NULL);
+	renderer->blur_pipeline = VK_NULL_HANDLE;
+	renderer->blur_layout = VK_NULL_HANDLE;
+	renderer->blur_ds_layout = VK_NULL_HANDLE;
+	renderer->blur_sampler = VK_NULL_HANDLE;
+}
+
+void vulkan_blur_buffer_finish(struct wlr_vk_render_buffer *buffer) {
+	VkDevice dev = buffer->renderer->dev->dev;
+	vkDestroyDescriptorPool(dev, buffer->blur_pool, NULL);
+	buffer->blur_pool = VK_NULL_HANDLE;
+	for (size_t i = 0; i < 2; i++) {
+		vkDestroyImageView(dev, buffer->blur_views[i], NULL);
+		vkDestroyImage(dev, buffer->blur_images[i], NULL);
+		vkFreeMemory(dev, buffer->blur_memory[i], NULL);
+		buffer->blur_views[i] = VK_NULL_HANDLE;
+		buffer->blur_images[i] = VK_NULL_HANDLE;
+		buffer->blur_memory[i] = VK_NULL_HANDLE;
+		buffer->blur_sets[i] = VK_NULL_HANDLE;
+	}
+	buffer->blur_transitioned = false;
+}
+
+static bool blur_pipeline_init(struct wlr_vk_renderer *renderer) {
+	if (renderer->blur_pipeline != VK_NULL_HANDLE) {
+		return true;
+	}
+	if (!renderer->dev->blur_compute) {
+		return false;
+	}
+	VkFormatProperties props;
+	vkGetPhysicalDeviceFormatProperties(renderer->dev->phdev,
+		VK_FORMAT_R16G16B16A16_SFLOAT, &props);
+	VkFormatFeatureFlags required = VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT |
+		VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+	if ((props.optimalTilingFeatures & required) != required) {
+		return false;
+	}
+	VkDevice dev = renderer->dev->dev;
+	VkDescriptorSetLayoutBinding bindings[] = {
+		{.binding = 0, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+			.descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT},
+		{.binding = 1, .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+			.descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT},
+	};
+	VkDescriptorSetLayoutCreateInfo ds_info = {
+		.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+		.bindingCount = 2, .pBindings = bindings,
+	};
+	if (vkCreateDescriptorSetLayout(dev, &ds_info, NULL, &renderer->blur_ds_layout) != VK_SUCCESS) {
+		goto error;
+	}
+	VkPushConstantRange push = {.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT, .size = 24};
+	VkPipelineLayoutCreateInfo layout_info = {
+		.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+		.setLayoutCount = 1, .pSetLayouts = &renderer->blur_ds_layout,
+		.pushConstantRangeCount = 1, .pPushConstantRanges = &push,
+	};
+	if (vkCreatePipelineLayout(dev, &layout_info, NULL, &renderer->blur_layout) != VK_SUCCESS) {
+		goto error;
+	}
+	VkSamplerCreateInfo sampler = {
+		.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+		.magFilter = VK_FILTER_NEAREST, .minFilter = VK_FILTER_NEAREST,
+		.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+		.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+		.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+		.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+	};
+	if (vkCreateSampler(dev, &sampler, NULL, &renderer->blur_sampler) != VK_SUCCESS) {
+		goto error;
+	}
+	VkShaderModule shader;
+	VkShaderModuleCreateInfo shader_info = {
+		.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+		.codeSize = sizeof(blur_comp_data), .pCode = blur_comp_data,
+	};
+	if (vkCreateShaderModule(dev, &shader_info, NULL, &shader) != VK_SUCCESS) {
+		goto error;
+	}
+	VkComputePipelineCreateInfo pipe_info = {
+		.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+		.stage = {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+			.stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = shader, .pName = "main"},
+		.layout = renderer->blur_layout,
+	};
+	VkResult result = vkCreateComputePipelines(dev, VK_NULL_HANDLE, 1,
+		&pipe_info, NULL, &renderer->blur_pipeline);
+	vkDestroyShaderModule(dev, shader, NULL);
+	if (result != VK_SUCCESS) {
+		goto error;
+	}
+	return true;
+error:
+	vulkan_blur_finish(renderer);
+	return false;
+}
+
+static bool blur_allocate(struct wlr_vk_render_buffer *buffer) {
+	if (buffer->blur_pool != VK_NULL_HANDLE) {
+		return true;
+	}
+	struct wlr_vk_renderer *renderer = buffer->renderer;
+	if (!blur_pipeline_init(renderer)) {
+		return false;
+	}
+	VkDevice dev = renderer->dev->dev;
+	for (size_t i = 0; i < 2; i++) {
+		VkImageCreateInfo info = {
+			.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+			.imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_R16G16B16A16_SFLOAT,
+			.extent = {buffer->wlr_buffer->width, buffer->wlr_buffer->height, 1},
+			.mipLevels = 1, .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT,
+			.tiling = VK_IMAGE_TILING_OPTIMAL,
+			.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+				VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+			.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+		};
+		if (vkCreateImage(dev, &info, NULL, &buffer->blur_images[i]) != VK_SUCCESS) {
+			goto error;
+		}
+		VkMemoryRequirements req;
+		vkGetImageMemoryRequirements(dev, buffer->blur_images[i], &req);
+		int type = vulkan_find_mem_type(renderer->dev,
+			VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, req.memoryTypeBits);
+		if (type < 0) {
+			goto error;
+		}
+		VkMemoryAllocateInfo alloc = {
+			.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+			.allocationSize = req.size, .memoryTypeIndex = type,
+		};
+		if (vkAllocateMemory(dev, &alloc, NULL, &buffer->blur_memory[i]) != VK_SUCCESS ||
+				vkBindImageMemory(dev, buffer->blur_images[i], buffer->blur_memory[i], 0) != VK_SUCCESS) {
+			goto error;
+		}
+		VkImageViewCreateInfo view = {
+			.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+			.image = buffer->blur_images[i], .viewType = VK_IMAGE_VIEW_TYPE_2D,
+			.format = info.format,
+			.subresourceRange = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+				.levelCount = 1, .layerCount = 1},
+		};
+		if (vkCreateImageView(dev, &view, NULL, &buffer->blur_views[i]) != VK_SUCCESS) {
+			goto error;
+		}
+	}
+	VkDescriptorPoolSize sizes[] = {
+		{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 2},
+		{VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2},
+	};
+	VkDescriptorPoolCreateInfo pool = {
+		.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+		.maxSets = 2, .poolSizeCount = 2, .pPoolSizes = sizes,
+	};
+	if (vkCreateDescriptorPool(dev, &pool, NULL, &buffer->blur_pool) != VK_SUCCESS) {
+		goto error;
+	}
+	VkDescriptorSetLayout layouts[] = {renderer->blur_ds_layout, renderer->blur_ds_layout};
+	VkDescriptorSetAllocateInfo ds = {
+		.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+		.descriptorPool = buffer->blur_pool, .descriptorSetCount = 2,
+		.pSetLayouts = layouts,
+	};
+	if (vkAllocateDescriptorSets(dev, &ds, buffer->blur_sets) != VK_SUCCESS) {
+		goto error;
+	}
+	for (size_t i = 0; i < 2; i++) {
+		VkDescriptorImageInfo images[] = {
+			{.sampler = renderer->blur_sampler,
+				.imageView = i == 0 ? buffer->two_pass.blend_image_view : buffer->blur_views[0],
+				.imageLayout = VK_IMAGE_LAYOUT_GENERAL},
+			{.imageView = buffer->blur_views[i], .imageLayout = VK_IMAGE_LAYOUT_GENERAL},
+		};
+		VkWriteDescriptorSet writes[] = {
+			{.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+				.dstSet = buffer->blur_sets[i], .dstBinding = 0, .descriptorCount = 1,
+				.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .pImageInfo = &images[0]},
+			{.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+				.dstSet = buffer->blur_sets[i], .dstBinding = 1, .descriptorCount = 1,
+				.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .pImageInfo = &images[1]},
+		};
+		vkUpdateDescriptorSets(dev, 2, writes, 0, NULL);
+	}
+	return true;
+error:
+	vulkan_blur_buffer_finish(buffer);
+	return false;
+}
+
+static void blur_barrier(VkCommandBuffer cb, VkImage image,
+		VkImageLayout old_layout, VkImageLayout new_layout,
+		VkPipelineStageFlags src_stage, VkAccessFlags src_access,
+		VkPipelineStageFlags dst_stage, VkAccessFlags dst_access) {
+	VkImageMemoryBarrier barrier = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+		.srcAccessMask = src_access, .dstAccessMask = dst_access,
+		.oldLayout = old_layout, .newLayout = new_layout,
+		.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+		.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .image = image,
+		.subresourceRange = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+			.levelCount = 1, .layerCount = 1},
+	};
+	vkCmdPipelineBarrier(cb, src_stage, dst_stage, 0, 0, NULL, 0, NULL, 1, &barrier);
+}
+
+bool vulkan_blur_render(struct wlr_vk_render_pass *pass,
+		const struct wlr_render_background_blur_options *options) {
+	struct wlr_vk_render_buffer *buffer = pass->render_buffer;
+	if (!pass->two_pass || !blur_allocate(buffer)) {
+		return false;
+	}
+	int width = buffer->wlr_buffer->width, height = buffer->wlr_buffer->height;
+	pixman_region32_t region;
+	pixman_region32_init_rect(&region, 0, 0, width, height);
+	if (options->clip != NULL) {
+		pixman_region32_intersect(&region, &region, options->clip);
+	}
+	pixman_region32_intersect_rect(&region, &region, options->dst_box.x, options->dst_box.y,
+		options->dst_box.width, options->dst_box.height);
+	if (!pixman_region32_not_empty(&region)) {
+		pixman_region32_fini(&region);
+		return true;
+	}
+	VkCommandBuffer cb = pass->command_buffer->vk;
+	vkCmdNextSubpass(cb, VK_SUBPASS_CONTENTS_INLINE);
+	vkCmdEndRenderPass(cb);
+	pass->bound_pipeline = VK_NULL_HANDLE;
+	VkImage source = buffer->two_pass.blend_image;
+	blur_barrier(cb, source, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL,
+		VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_INPUT_ATTACHMENT_READ_BIT,
+		VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+	for (size_t i = 0; i < 2; i++) {
+		blur_barrier(cb, buffer->blur_images[i],
+			buffer->blur_transitioned ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED,
+			VK_IMAGE_LAYOUT_GENERAL,
+			buffer->blur_transitioned ? VK_PIPELINE_STAGE_ALL_COMMANDS_BIT : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+			buffer->blur_transitioned ? VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT : 0,
+			VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+	}
+	buffer->blur_transitioned = true;
+	vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pass->renderer->blur_pipeline);
+	pixman_box32_t extent = *pixman_region32_extents(&region);
+	/* Horizontal reconstruction extends vertically by the kernel's reach, so
+	 * the second pass never samples stale scratch pixels. Source taps extend
+	 * across the window boundary into the complete linear scene prefix. */
+	for (int axis = 0; axis < 2; axis++) {
+		int top = axis == 0 ? (extent.y1 > 24 ? extent.y1 - 24 : 0) : extent.y1;
+		int bottom = axis == 0 ? (extent.y2 + 24 < height ? extent.y2 + 24 : height) : extent.y2;
+		int32_t push[] = {extent.x1, top, extent.x2 - extent.x1, bottom - top,
+			axis == 0, axis == 1};
+		vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE,
+			pass->renderer->blur_layout, 0, 1, &buffer->blur_sets[axis], 0, NULL);
+		vkCmdPushConstants(cb, pass->renderer->blur_layout,
+			VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), push);
+		vkCmdDispatch(cb, (push[2] + 15) / 16, (push[3] + 15) / 16, 1);
+		blur_barrier(cb, buffer->blur_images[axis], VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+			VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+			axis == 0 ? VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT : VK_PIPELINE_STAGE_TRANSFER_BIT,
+			axis == 0 ? VK_ACCESS_SHADER_READ_BIT : VK_ACCESS_TRANSFER_READ_BIT);
+	}
+	blur_barrier(cb, source, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+		VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+		VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+	int count;
+	pixman_box32_t *rects = pixman_region32_rectangles(&region, &count);
+	for (int i = 0; i < count; i++) {
+		pixman_box32_t r = rects[i];
+		VkImageCopy copy = {
+			.srcSubresource = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT, .layerCount = 1},
+			.dstSubresource = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT, .layerCount = 1},
+			.srcOffset = {r.x1, r.y1, 0}, .dstOffset = {r.x1, r.y1, 0},
+			.extent = {r.x2 - r.x1, r.y2 - r.y1, 1},
+		};
+		vkCmdCopyImage(cb, buffer->blur_images[1], VK_IMAGE_LAYOUT_GENERAL,
+			source, VK_IMAGE_LAYOUT_GENERAL, 1, &copy);
+		rect_union_add(&pass->updated_region, r);
+	}
+	pixman_region32_fini(&region);
+	blur_barrier(cb, source, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+		VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+		VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);
+	VkRenderPassBeginInfo begin = {
+		.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+		.renderPass = pass->render_setup->render_pass,
+		.framebuffer = pass->render_buffer_out->framebuffer,
+		.renderArea.extent = {width, height},
+	};
+	vkCmdBeginRenderPass(cb, &begin, VK_SUBPASS_CONTENTS_INLINE);
