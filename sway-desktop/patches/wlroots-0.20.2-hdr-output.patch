+static uint32_t encode_luminance(double value, double scale) {
+	if (!isfinite(value) || value <= 0) {
+		return 0;
+	}
+	double encoded = round(value * scale);
+	return encoded >= UINT32_MAX ? UINT32_MAX : (uint32_t)encoded;
+}
+
+void wlr_color_manager_v1_get_output_image_description_data(struct wlr_output *output,
+		struct wlr_image_description_v1_data *data) {
+	*data = (struct wlr_image_description_v1_data){
+		.tf_named = WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_GAMMA22,
+		.primaries_named = WP_COLOR_MANAGER_V1_PRIMARIES_SRGB,
+		.has_luminances = true,
+	};
+	wlr_color_transfer_function_get_default_luminance(
+		WLR_COLOR_TRANSFER_FUNCTION_GAMMA22, &data->luminances);
+	const struct wlr_output_image_description *desc = output->image_description;
+	if (desc == NULL) {
+		return;
+	}
+	data->tf_named = wlr_color_manager_v1_transfer_function_from_wlr(desc->transfer_function);
+	data->primaries_named = wlr_color_manager_v1_primaries_from_wlr(desc->primaries);
+	wlr_color_transfer_function_get_default_luminance(desc->transfer_function, &data->luminances);
+	if (desc->transfer_function == WLR_COLOR_TRANSFER_FUNCTION_ST2084_PQ &&
+			isfinite(desc->sdr_white_level) && desc->sdr_white_level > 0) {
+		data->luminances.reference = desc->sdr_white_level;
+	}
+	const struct wlr_color_primaries *p = &desc->mastering_display_primaries;
+	if (p->red.y > 0 && p->green.y > 0 && p->blue.y > 0 && p->white.y > 0) {
+		data->has_mastering_display_primaries = true;
+		data->mastering_display_primaries = *p;
+	}
+	if (isfinite(desc->mastering_luminance.min) && isfinite(desc->mastering_luminance.max) &&
+			desc->mastering_luminance.min >= 0 &&
+			desc->mastering_luminance.max > desc->mastering_luminance.min) {
+		data->has_mastering_luminance = true;
+		data->mastering_luminance.min = desc->mastering_luminance.min;
+		data->mastering_luminance.max = desc->mastering_luminance.max;
+	}
+	data->max_cll = encode_luminance(desc->max_cll, 1);
+	data->max_fall = encode_luminance(desc->max_fall, 1);
 }
 
