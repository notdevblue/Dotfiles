diff --git a/sway/commands/output/hdr.c b/sway/commands/output/hdr.c
index 26d2022..cdfca08 100644
--- a/sway/commands/output/hdr.c
+++ b/sway/commands/output/hdr.c
@@ -1,3 +1,5 @@
+#include <math.h>
+#include <stdlib.h>
 #include <strings.h>
 #include "sway/commands.h"
 #include "sway/config.h"
@@ -35,3 +37,26 @@ struct cmd_results *output_cmd_hdr(int argc, char **argv) {
 	config->handler_context.leftovers.argv = argv + 1;
 	return NULL;
 }
+
+// Controls SDR reference white on HDR outputs without scaling native HDR pixels.
+struct cmd_results *output_cmd_sdr_white_level(int argc, char **argv) {
+	if (!config->handler_context.output_config) {
+		return cmd_results_new(CMD_FAILURE, "Missing output config");
+	}
+	if (argc == 0) {
+		return cmd_results_new(CMD_INVALID, "Missing sdr_white_level argument");
+	}
+	float level = 203.0f;
+	if (strcasecmp(argv[0], "default") != 0) {
+		char *end;
+		level = strtof(argv[0], &end);
+		if (end == argv[0] || *end || !isfinite(level) || level < 1 || level > 1000) {
+			return cmd_results_new(CMD_INVALID,
+				"Expected sdr_white_level default or a number from 1 to 1000 cd/m²");
+		}
+	}
+	config->handler_context.output_config->sdr_white_level = level;
+	config->handler_context.leftovers.argc = argc - 1;
+	config->handler_context.leftovers.argv = argv + 1;
+	return NULL;
+}
