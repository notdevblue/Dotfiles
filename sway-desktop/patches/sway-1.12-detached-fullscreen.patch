diff --git a/tests/detached-client.c b/tests/detached-client.c
new file mode 100644
index 0000000..de04f62
--- /dev/null
+++ b/tests/detached-client.c
@@ -0,0 +1,136 @@
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <wayland-client.h>
+#include "xdg-shell-client-protocol.h"
+
+static struct wl_display *display;
+static struct wl_compositor *compositor;
+static struct wl_shm *shm;
+static struct xdg_wm_base *wm;
+static struct wl_surface *surface;
+static struct xdg_surface *xdg_surface;
+static struct xdg_toplevel *toplevel;
+static int width = 640, height = 480;
+static int fullscreen;
+
+static void release(void *data, struct wl_buffer *buffer) {
+	wl_buffer_destroy(buffer);
+}
+static const struct wl_buffer_listener buffer_listener = { .release = release };
+
+static void draw(void) {
+	char path[] = "/tmp/sway-detached-buffer-XXXXXX";
+	int fd = mkstemp(path);
+	assert(fd >= 0);
+	unlink(path);
+	size_t size = (size_t)width * height * 4;
+	assert(ftruncate(fd, size) == 0);
+	void *pixels = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	assert(pixels != MAP_FAILED);
+	memset(pixels, 0x55, size);
+	struct wl_shm_pool *pool = wl_shm_create_pool(shm, fd, size);
+	struct wl_buffer *buffer = wl_shm_pool_create_buffer(pool, 0, width, height,
+			width * 4, WL_SHM_FORMAT_XRGB8888);
+	wl_buffer_add_listener(buffer, &buffer_listener, NULL);
+	wl_shm_pool_destroy(pool);
+	munmap(pixels, size);
+	close(fd);
+	wl_surface_attach(surface, buffer, 0, 0);
+	wl_surface_damage(surface, 0, 0, width, height);
+	wl_surface_commit(surface);
+}
+
+static void configure_surface(void *data, struct xdg_surface *s, uint32_t serial) {
+	xdg_surface_ack_configure(s, serial);
+	draw();
+	printf("STATE %d %d %d\n", width, height, fullscreen);
+	fflush(stdout);
+}
+static const struct xdg_surface_listener surface_listener = {
+	.configure = configure_surface,
+};
+
+static void configure_toplevel(void *data, struct xdg_toplevel *t,
+		int32_t w, int32_t h, struct wl_array *states) {
+	if (w > 0) width = w;
+	if (h > 0) height = h;
+	fullscreen = 0;
+	uint32_t *state;
+	wl_array_for_each(state, states) {
+		fullscreen |= *state == XDG_TOPLEVEL_STATE_FULLSCREEN;
+	}
+}
+static void close_toplevel(void *data, struct xdg_toplevel *t) {
+	exit(0);
+}
+static const struct xdg_toplevel_listener toplevel_listener = {
+	.configure = configure_toplevel,
+	.close = close_toplevel,
+};
+
+static void ping(void *data, struct xdg_wm_base *w, uint32_t serial) {
+	xdg_wm_base_pong(w, serial);
+}
+static const struct xdg_wm_base_listener wm_listener = { .ping = ping };
+
+static void global(void *data, struct wl_registry *r, uint32_t name,
+		const char *interface, uint32_t version) {
+	if (strcmp(interface, "wl_compositor") == 0) {
+		compositor = wl_registry_bind(r, name, &wl_compositor_interface, 4);
+	} else if (strcmp(interface, "wl_shm") == 0) {
+		shm = wl_registry_bind(r, name, &wl_shm_interface, 1);
+	} else if (strcmp(interface, "xdg_wm_base") == 0) {
+		wm = wl_registry_bind(r, name, &xdg_wm_base_interface, 1);
+		xdg_wm_base_add_listener(wm, &wm_listener, NULL);
+	}
+}
+static void global_remove(void *data, struct wl_registry *r, uint32_t name) {}
+static const struct wl_registry_listener registry_listener = {
+	.global = global,
+	.global_remove = global_remove,
+};
+
+int main(int argc, char **argv) {
+	display = wl_display_connect(NULL);
+	assert(display);
+	struct wl_registry *registry = wl_display_get_registry(display);
+	wl_registry_add_listener(registry, &registry_listener, NULL);
+	wl_display_roundtrip(display);
+	assert(compositor && shm && wm);
+	surface = wl_compositor_create_surface(compositor);
+	xdg_surface = xdg_wm_base_get_xdg_surface(wm, surface);
+	xdg_surface_add_listener(xdg_surface, &surface_listener, NULL);
+	toplevel = xdg_surface_get_toplevel(xdg_surface);
+	xdg_toplevel_add_listener(toplevel, &toplevel_listener, NULL);
+	xdg_toplevel_set_app_id(toplevel, argc > 1 ? argv[1] : "detached-test");
+	xdg_toplevel_set_title(toplevel, "Fullscreen protocol test");
+	wl_surface_commit(surface);
+	struct pollfd fds[] = {
+		{ .fd = wl_display_get_fd(display), .events = POLLIN },
+		{ .fd = STDIN_FILENO, .events = POLLIN },
+	};
+	for (;;) {
+		if (wl_display_dispatch_pending(display) < 0) break;
+		wl_display_flush(display);
+		if (poll(fds, 2, -1) < 0) break;
+		if (fds[0].revents & POLLIN) {
+			if (wl_display_dispatch(display) < 0) break;
+		}
+		if (fds[1].revents & POLLIN) {
+			char command;
+			if (read(STDIN_FILENO, &command, 1) != 1 || command == 'q') break;
+			if (command == 'f') xdg_toplevel_set_fullscreen(toplevel, NULL);
+			if (command == 'u') xdg_toplevel_unset_fullscreen(toplevel);
+			wl_surface_commit(surface);
+		}
+	}
+	wl_display_disconnect(display);
+	return 0;
+}
diff --git a/tests/verify-detached.py b/tests/verify-detached.py
new file mode 100644
index 0000000..a86a8e9
--- /dev/null
+++ b/tests/verify-detached.py
@@ -0,0 +1,195 @@
+#!/usr/bin/env python3
+"""Exercise actual xdg-shell state and geometry on an isolated headless Sway."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+BUILD = ROOT / "build"
+subprocess.run(["wayland-scanner", "client-header",
+    "/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml",
+    str(BUILD / "xdg-shell-client-protocol.h")], check=True)
+subprocess.run(["wayland-scanner", "private-code",
+    "/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml",
+    str(BUILD / "xdg-shell-test.c")], check=True)
+flags = subprocess.check_output(
+    ["pkg-config", "--cflags", "--libs", "wayland-client"], text=True).split()
+subprocess.run(["cc", "-Wall", "-Wextra", "-Wno-unused-parameter", "-Werror",
+    "-I" + str(BUILD), str(ROOT / "tests/detached-client.c"),
+    str(BUILD / "xdg-shell-test.c"), "-o", str(BUILD / "detached-client"),
+    *flags], check=True)
+
+def wait_for(fn, description):
+    deadline = time.monotonic() + 8
+    while time.monotonic() < deadline:
+        value = fn()
+        if value:
+            return value
+        time.sleep(0.03)
+    raise AssertionError("Timed out: " + description)
+
+with tempfile.TemporaryDirectory(prefix="sway-detached-test-") as temp:
+    runtime = Path(temp)
+    config = runtime / "config"
+    config.write_text("""output HEADLESS-1 mode 1280x720
+default_border none
+font pango:monospace 10
+seat seat0 fallback true
+xwayland disable
+for_window [app_id="detached-auto"] inhibit_fullscreen enable
+""")
+    env = dict(os.environ, XDG_RUNTIME_DIR=temp, WLR_BACKENDS="headless",
+        WLR_RENDERER=os.environ.get("SWAY_TEST_RENDERER", "pixman"), WLR_HEADLESS_OUTPUTS="1")
+    for key in ("SWAYSOCK", "WAYLAND_DISPLAY", "DISPLAY", "WAYLAND_SOCKET"):
+        env.pop(key, None)
+    log = open(BUILD / "headless-test.log", "w")
+    sway = subprocess.Popen([str(BUILD / "sway/sway"), "-c", str(config),
+        "--unsupported-gpu"], env=env, stdout=log, stderr=log)
+    clients = []
+    try:
+        sock = wait_for(lambda: next(runtime.glob("sway-ipc.*.sock"), None),
+            "headless compositor socket")
+        wayland = wait_for(lambda: next((p for p in runtime.glob("wayland-*")
+            if not p.name.endswith(".lock")), None), "Wayland socket")
+        env["WAYLAND_DISPLAY"] = wayland.name
+
+        def ipc(command, kind=None, success=True):
+            args = ["swaymsg", "-s", str(sock), "-r"]
+            if kind:
+                args += ["-t", kind]
+            else:
+                args += [command]
+            result = subprocess.run(args, capture_output=True, text=True)
+            data = json.loads(result.stdout)
+            if not kind:
+                assert all(row.get("success", False) == success for row in data), data
+            return data
+
+        def nodes(node):
+            yield node
+            for child in node.get("nodes", []) + node.get("floating_nodes", []):
+                yield from nodes(child)
+
+        def view(app="detached-test"):
+            return next((n for n in nodes(ipc(None, "get_tree"))
+                if n.get("app_id") == app), None)
+
+        class Client:
+            def __init__(self, app):
+                self.app = app
+                self.process = subprocess.Popen([str(BUILD / "detached-client"), app],
+                    env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+                clients.append(self.process)
+                os.set_blocking(self.process.stdout.fileno(), False)
+                self.pending = b""
+                self.state = None
+                wait_for(lambda: view(app), "mapped " + app)
+                wait_for(self.read, "initial configure")
+
+            def read(self):
+                try:
+                    self.pending += os.read(self.process.stdout.fileno(), 65536)
+                except BlockingIOError:
+                    pass
+                while b"\n" in self.pending:
+                    line, self.pending = self.pending.split(b"\n", 1)
+                    if line.startswith(b"STATE "):
+                        self.state = tuple(map(int, line.split()[1:]))
+                return self.state
+
+            def request(self, fullscreen):
+                self.process.stdin.write(b"f" if fullscreen else b"u")
+                self.process.stdin.flush()
+
+            def expect(self, fs, geometry=None):
+                def match():
+                    state = self.read()
+                    return state and state[2] == fs and (
+                        geometry is None or state[:2] == geometry)
+                wait_for(match, f"client fullscreen={fs}, geometry={geometry}")
+                return self.state
+
+        def command(text):
+            return ipc('[app_id="detached-test"] ' + text)
+
+        client = Client("detached-test")
+        command("floating enable, resize set width 640 px height 480 px")
+        client.expect(0, (640, 480))
+        client.request(True)
+        client.expect(1, (1280, 720))
+        assert view()["fullscreen_mode"] == 1
+        client.request(False)
+        client.expect(0, (640, 480))
+        print("PASS: ordinary client fullscreen and restore")
+
+        command("inhibit_fullscreen enable")
+        client.request(True)
+        client.expect(1, (640, 480))
+        assert view()["fullscreen_mode"] == 0
+        assert view()["client_fullscreen"] and view()["inhibit_fullscreen"]
+        for mode in ("enable", "disable", "enable global", "disable"):
+            command("fullscreen " + mode)
+            client.expect(1, (640, 480) if mode == "disable" else (1280, 720))
+        client.request(False)
+        client.expect(0, (640, 480))
+        command("fullscreen enable")
+        client.expect(0, (1280, 720))
+        client.request(True)
+        client.expect(1, (1280, 720))
+        client.request(False)
+        client.expect(0, (1280, 720))
+        assert view()["fullscreen_mode"] == 1
+        print("PASS: client UI and workspace/global geometry are independent")
+
+        command("inhibit_fullscreen disable")
+        client.expect(1, (1280, 720))
+        command("fullscreen disable")
+        client.expect(0, (640, 480))
+        client.request(True)
+        client.expect(1, (1280, 720))
+        command("inhibit_fullscreen toggle")
+        command("fullscreen disable")
+        client.expect(1, (640, 480))
+        command("inhibit_fullscreen toggle")
+        client.expect(0, (640, 480))
+        print("PASS: F11 then detach then restore geometry; rejoin restores UI")
+
+        command("inhibit_fullscreen enable, floating disable")
+        before = view()["rect"]
+        client.request(True)
+        client.expect(1)
+        assert view()["rect"] == before
+        command("move to workspace 2")
+        ipc("workspace 2")
