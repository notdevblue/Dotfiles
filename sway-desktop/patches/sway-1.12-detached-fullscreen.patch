new file mode 100644
index 0000000..fc5eec9
--- /dev/null
+++ b/sway/commands/inhibit_fullscreen.c
@@ -0,0 +1,31 @@
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/tree/container.h"
+
+// inhibit_fullscreen enable|disable|toggle
+struct cmd_results *cmd_inhibit_fullscreen(int argc, char **argv) {
+	struct cmd_results *error = checkarg(argc, "inhibit_fullscreen",
+			EXPECTED_EQUAL_TO, 1);
+	if (error) {
+		return error;
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (!con || !con->view) {
+		return cmd_results_new(CMD_INVALID,
+				"Only views can have fullscreen inhibitors");
+	}
+	bool enable;
+	if (strcasecmp(argv[0], "enable") == 0) {
+		enable = true;
+	} else if (strcasecmp(argv[0], "disable") == 0) {
+		enable = false;
+	} else if (strcasecmp(argv[0], "toggle") == 0) {
+		enable = !con->inhibit_fullscreen;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+				"Expected inhibit_fullscreen enable|disable|toggle");
+	}
+	container_set_inhibit_fullscreen(con, enable);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
