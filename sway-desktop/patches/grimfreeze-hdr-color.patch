diff --git a/color.c b/color.c
new file mode 100644
--- /dev/null
+++ b/color.c
@@ -0,0 +1,195 @@
+#include <errno.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libavfilter/avfilter.h>
+#include <libavfilter/buffersink.h>
+#include <libavfilter/buffersrc.h>
+#include <libavutil/opt.h>
+#include "color.h"
+#include "color-management-v1-protocol.h"
+
+static void manager_intent(void *data, struct wp_color_manager_v1 *manager, uint32_t intent) {}
+static void manager_feature(void *data, struct wp_color_manager_v1 *manager, uint32_t feature) {
+	struct grim_state *state = data;
+	if (feature == WP_COLOR_MANAGER_V1_FEATURE_PARAMETRIC) state->color_parametric = true;
+}
+static void manager_tf(void *data, struct wp_color_manager_v1 *manager, uint32_t tf) {
+	struct grim_state *state = data;
+	if (tf == WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ) state->color_pq = true;
+}
+static void manager_primaries(void *data, struct wp_color_manager_v1 *manager, uint32_t primaries) {
+	struct grim_state *state = data;
+	if (primaries == WP_COLOR_MANAGER_V1_PRIMARIES_BT2020) state->color_bt2020 = true;
+}
+static void manager_done(void *data, struct wp_color_manager_v1 *manager) {}
+static const struct wp_color_manager_v1_listener manager_listener = {
+	.supported_intent = manager_intent, .supported_feature = manager_feature,
+	.supported_tf_named = manager_tf, .supported_primaries_named = manager_primaries,
+	.done = manager_done,
+};
+void color_bind(struct grim_state *state, struct wl_registry *registry, uint32_t name) {
+	state->color_manager = wl_registry_bind(registry, name, &wp_color_manager_v1_interface, 1);
+	wp_color_manager_v1_add_listener(state->color_manager, &manager_listener, state);
+}
+static void description_failed(void *data, struct wp_image_description_v1 *desc,
+	uint32_t cause, const char *message) {
+	struct grim_state *state = data;
+	fprintf(stderr, "HDR image description failed: %s\n", message);
+	state->color_failed = true;
+}
+static void description_ready(void *data, struct wp_image_description_v1 *desc, uint32_t identity) {
+	struct grim_state *state = data;
+	state->color_ready = true;
+}
+static const struct wp_image_description_v1_listener description_listener = {
+	.failed = description_failed, .ready = description_ready,
+};
+
+bool color_prepare(struct grim_state *state, const char **hints, size_t count, bool freeze) {
+	for (size_t i = 0; i < count; i++) {
+		const char *separator = strrchr(hints[i], '=');
+		char *end;
+		errno = 0;
+		double white = separator ? strtod(separator + 1, &end) : 0;
+		if (!separator || separator == hints[i] || end == separator + 1 || *end ||
+			errno || !isfinite(white) || white < 1 || white > 10000) {
+			fprintf(stderr, "invalid HDR output hint; expected output=reference-white-nits\n");
+			return false;
+		}
+		bool found = false;
+		struct grim_output *output;
+		wl_list_for_each(output, &state->outputs, link) {
+			if (output->name && strlen(output->name) == (size_t)(separator - hints[i]) &&
+					strncmp(output->name, hints[i], separator - hints[i]) == 0) {
+				output->sdr_white = white;
+				found = true;
+			}
+		}
+		if (!found) {
+			fprintf(stderr, "HDR output disappeared before capture\n");
+			return false;
+		}
+	}
+	if (!count || !freeze) return true;
+	if (!state->color_manager || !state->color_parametric || !state->color_pq || !state->color_bt2020) {
+		fprintf(stderr, "compositor cannot color-manage the frozen HDR image\n");
+		return false;
+	}
+	struct wp_image_description_creator_params_v1 *creator =
+		wp_color_manager_v1_create_parametric_creator(state->color_manager);
+	wp_image_description_creator_params_v1_set_tf_named(creator, WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+	wp_image_description_creator_params_v1_set_primaries_named(creator, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020);
+	state->pq_description = wp_image_description_creator_params_v1_create(creator);
+	wp_image_description_v1_add_listener(state->pq_description, &description_listener, state);
+	while (!state->color_ready && !state->color_failed) {
+		if (wl_display_roundtrip(state->display) < 0) return false;
+	}
+	return state->color_ready;
+}
+struct wp_color_management_surface_v1 *color_surface(struct grim_state *state,
+		struct grim_output *output, struct wl_surface *surface) {
+	if (!output->sdr_white) return NULL;
+	struct wp_color_management_surface_v1 *color = wp_color_manager_v1_get_surface(state->color_manager, surface);
+	wp_color_management_surface_v1_set_image_description(color, state->pq_description,
+		WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+	return color;
+}
+
+/* ST 2084 electrical values are absolute: 1.0 encodes 10,000 cd/m². */
+static double pq_decode(double value) {
+	double p = pow(value, 32.0 / 2523.0);
+	return 10000.0 * pow(fmax(p - 3424.0 / 4096.0, 0) /
+		(2413.0 / 128.0 - 2392.0 / 128.0 * p), 16384.0 / 2610.0);
+}
+static double pq_encode(double nits) {
+	double p = pow(fmax(nits, 0) / 10000.0, 2610.0 / 16384.0);
+	return pow((3424.0 / 4096.0 + 2413.0 / 128.0 * p) /
+		(1.0 + 2392.0 / 128.0 * p), 2523.0 / 32.0);
+}
+static double srgb_decode(double value) {
+	return value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4);
+}
+pixman_color_t color_ui_to_hdr(pixman_color_t color, double white) {
+	if (!white) return color;
+	double r = srgb_decode(color.red / 65535.0), g = srgb_decode(color.green / 65535.0), b = srgb_decode(color.blue / 65535.0);
+	/* Linear BT.709 -> BT.2020; UI colors are not tone-mapped. */
+	color.red = lround(pq_encode(white * (0.6274040*r + 0.3292820*g + 0.0433136*b)) * 65535);
+	color.green = lround(pq_encode(white * (0.0690970*r + 0.9195400*g + 0.0113612*b)) * 65535);
+	color.blue = lround(pq_encode(white * (0.0163916*r + 0.0880132*g + 0.8955950*b)) * 65535);
+	return color;
+}
+
+pixman_image_t *color_to_sdr(pixman_image_t *image, double white) {
+	int width = pixman_image_get_width(image), height = pixman_image_get_height(image);
+	pixman_image_t *rgba = pixman_image_create_bits(PIXMAN_rgba_float, width, height, NULL, 0);
+	if (!rgba) return NULL;
+	pixman_image_composite32(PIXMAN_OP_SRC, image, NULL, rgba, 0, 0, 0, 0, 0, 0, width, height);
+	float *pixels = (float *)pixman_image_get_data(rgba);
+	int stride = pixman_image_get_stride(rgba);
+	double peak_value = 0;
+	for (int y = 0; y < height; y++) {
+		float *row = (float *)((char *)pixels + y * stride);
+		for (int x = 0; x < width; x++) for (int channel = 0; channel < 3; channel++) {
+			if (row[4 * x + channel] > peak_value) peak_value = row[4 * x + channel];
+		}
+	}
+	double peak = fmax(1.0, pq_decode(fmin(peak_value, 1.0)) / white);
+#if GRIM_LITTLE_ENDIAN
+	const char *format_name = "bgra";
+#else
+	const char *format_name = "argb";
+#endif
+	AVFilterGraph *graph = avfilter_graph_alloc();
+	AVFilterContext *source = NULL, *sink = NULL;
+	AVFilterInOut *inputs = avfilter_inout_alloc(), *outputs = avfilter_inout_alloc();
+	AVFrame *in = av_frame_alloc(), *out = av_frame_alloc();
+	pixman_image_t *result = NULL;
+	int error = AVERROR(ENOMEM);
+	if (!graph || !inputs || !outputs || !in || !out) goto done;
+	graph->nb_threads = 1;
+	char args[256], filters[768];
+	snprintf(args, sizeof(args), "video_size=%dx%d:pix_fmt=%d:time_base=1/1:pixel_aspect=1/1:colorspace=gbr:range=pc", width, height, AV_PIX_FMT_GBRPF32);
+	if ((error = avfilter_graph_create_filter(&source, avfilter_get_by_name("buffer"), "in", args, NULL, graph)) < 0 ||
+		(error = avfilter_graph_create_filter(&sink, avfilter_get_by_name("buffersink"), "out", NULL, NULL, graph)) < 0) goto done;
+	outputs->name = av_strdup("in"); outputs->filter_ctx = source; outputs->pad_idx = 0;
+	inputs->name = av_strdup("out"); inputs->filter_ctx = sink; inputs->pad_idx = 0;
+	/* Reuse FFmpeg/zimg for transfer/gamut conversion and Mobius highlight
+	 * compression. Its linear section preserves ordinary SDR-range colors. */
+	snprintf(filters, sizeof(filters),
+		"zscale=pin=bt2020:tin=smpte2084:min=gbr:rin=full:t=linear:npl=%.9g,"
+		"zscale=p=bt709,tonemap=tonemap=mobius:param=0.8:desat=0:peak=%.9g,"
+		"zscale=t=iec61966-2-1:m=gbr:r=full,format=%s", white, peak, format_name);
+	if ((error = avfilter_graph_parse_ptr(graph, filters, &inputs, &outputs, NULL)) < 0 ||
+		(error = avfilter_graph_config(graph, NULL)) < 0) goto done;
+	in->format = AV_PIX_FMT_GBRPF32; in->width = width; in->height = height; in->pts = 0;
+	in->color_primaries = AVCOL_PRI_BT2020; in->color_trc = AVCOL_TRC_SMPTE2084;
+	in->colorspace = AVCOL_SPC_RGB; in->color_range = AVCOL_RANGE_JPEG;
+	if ((error = av_frame_get_buffer(in, 32)) < 0) goto done;
+	/* Keep the capture's precision through the transfer/gamut conversion.
+	 * Pixman converts XR30 and other supported formats to floating point;
+	 * only the final sRGB PNG is quantized to eight bits. */
+	for (int y = 0; y < height; y++) {
+		float *row = (float *)((char *)pixels + y * stride);
+		float *g = (float *)(in->data[0] + y * in->linesize[0]);
+		float *b = (float *)(in->data[1] + y * in->linesize[1]);
+		float *r = (float *)(in->data[2] + y * in->linesize[2]);
+		for (int x = 0; x < width; x++) { r[x] = row[4*x]; g[x] = row[4*x+1]; b[x] = row[4*x+2]; }
+	}
+	if ((error = av_buffersrc_add_frame_flags(source, in, 0)) < 0 ||
+		(error = av_buffersink_get_frame(sink, out)) < 0) goto done;
+	result = pixman_image_create_bits(PIXMAN_x8r8g8b8, width, height, NULL, 0);
+	if (!result) { error = AVERROR(ENOMEM); goto done; }
+	for (int y = 0; y < height; y++) memcpy((char *)pixman_image_get_data(result) + y * pixman_image_get_stride(result),
+		out->data[0] + y * out->linesize[0], width * 4);
+ done:
+	if (error < 0) {
+		char message[AV_ERROR_MAX_STRING_SIZE]; av_strerror(error, message, sizeof(message));
+		fprintf(stderr, "HDR to SDR conversion failed: %s\n", message);
+	}
+	av_frame_free(&in); av_frame_free(&out);
+	avfilter_inout_free(&inputs); avfilter_inout_free(&outputs); avfilter_graph_free(&graph);
+	pixman_image_unref(rgba);
+	return result;
+}
