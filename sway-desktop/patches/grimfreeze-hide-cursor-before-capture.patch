+static const struct wl_callback_listener cursor_guard_frame_listener = {
+	.done = cursor_guard_frame_done,
+};
+
+// Output capture can contain software cursors even when cursor painting is
+// not requested (for example while a screen recorder locks software cursors).
+// Own a transparent pointer surface and hide its cursor before copying pixels.
+// Keep keyboard focus unchanged; no user input configuration is modified.
+struct freeze_state *freeze_hide_cursor(struct grim_state *state) {
+	if (state->compositor == NULL || state->layer_shell == NULL || state->seat == NULL ||
+			!(state->seat_capabilities & WL_SEAT_CAPABILITY_POINTER)) {
+		fprintf(stderr, "cursor-free region capture needs layer-shell and a pointer\n");
+		return NULL;
+	}
+	struct freeze_state *fs = calloc(1, sizeof(*fs));
+	if (fs == NULL) {
+		return NULL;
+	}
+	fs->state = state;
+	fs->hiding_cursor = true;
+	wl_list_init(&fs->outputs);
+	fs->pointer = wl_seat_get_pointer(state->seat);
+	wl_pointer_add_listener(fs->pointer, &pointer_listener, fs);
+	struct grim_output *output;
+	wl_list_for_each(output, &state->outputs, link) {
+		struct freeze_output *fo = calloc(1, sizeof(*fo));
+		if (fo == NULL) {
+			freeze_release_cursor_guard(fs);
+			return NULL;
+		}
+		fo->fs = fs;
+		fo->state = state;
+		fo->output = output;
+		wl_list_insert(&fs->outputs, &fo->link);
+		fo->surface = wl_compositor_create_surface(state->compositor);
+		fo->layer_surface = zwlr_layer_shell_v1_get_layer_surface(
+			state->layer_shell, fo->surface, output->wl_output,
+			ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY, "grim-freeze-cursor-guard");
+		zwlr_layer_surface_v1_add_listener(fo->layer_surface, &layer_listener, fo);
+		zwlr_layer_surface_v1_set_anchor(fo->layer_surface,
+			ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP | ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
+			ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT | ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT);
+		zwlr_layer_surface_v1_set_exclusive_zone(fo->layer_surface, -1);
+		wl_surface_commit(fo->surface);
+	}
+	// Configure covers, map their transparent buffers, then flush the NULL
+	// cursor request received on pointer.enter before requesting a capture.
+	for (int i = 0; i < 3; i++) {
+		if (wl_display_roundtrip(state->display) < 0) {
+			freeze_release_cursor_guard(fs);
+			return NULL;
+		}
+	}
+	// First present the covers (and receive pointer.enter), then present
+	// the frame with its cursor hidden. Both barriers use compositor frame
+	// callbacks, not timing guesses. Damage all outputs to clear old pixels.
+	for (int phase = 0; phase < 2; phase++) {
+		struct freeze_output *fo;
+		wl_list_for_each(fo, &fs->outputs, link) {
+			struct wl_callback *frame = wl_surface_frame(fo->surface);
+			wl_callback_add_listener(frame, &cursor_guard_frame_listener, fs);
+			fs->cursor_guard_frames++;
+			wl_surface_damage(fo->surface, 0, 0,
+				fo->output->logical_geometry.width, fo->output->logical_geometry.height);
+			wl_surface_commit(fo->surface);
+		}
+		while (fs->cursor_guard_frames > 0) {
+			if (wl_display_dispatch(state->display) < 0) {
+				freeze_release_cursor_guard(fs);
+				return NULL;
+			}
+		}
+		if (phase == 0 && !fs->cursor_hidden && state->virtual_pointer_manager != NULL) {
+			// Sway can lay out a secondary output after the initial pointer
+			// rebase. Re-evaluate focus without moving the user's cursor.
+			struct zwlr_virtual_pointer_v1 *pointer =
+				zwlr_virtual_pointer_manager_v1_create_virtual_pointer(
+					state->virtual_pointer_manager, state->seat);
+			struct timespec now;
+			clock_gettime(CLOCK_MONOTONIC, &now);
+			uint32_t msec = now.tv_sec * 1000 + now.tv_nsec / 1000000;
+			zwlr_virtual_pointer_v1_motion(pointer, msec, 0, 0);
+			zwlr_virtual_pointer_v1_frame(pointer);
+			zwlr_virtual_pointer_v1_destroy(pointer);
+			if (wl_display_roundtrip(state->display) < 0) {
+				freeze_release_cursor_guard(fs);
+				return NULL;
+			}
+		}
+	}
+	return fs;
+}
+
+void freeze_release_cursor_guard(struct freeze_state *fs) {
+	if (fs == NULL) {
+		return;
+	}
+	wl_pointer_release(fs->pointer);
+	struct freeze_output *fo, *tmp;
+	wl_list_for_each_safe(fo, tmp, &fs->outputs, link) {
+		wl_list_remove(&fo->link);
+		destroy_freeze_output(fo);
+	}
+	free(fs);
+}
