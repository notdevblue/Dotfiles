+++ b/sway/commands/background_blur.c
@@ -0,0 +1,25 @@
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/tree/container.h"
+#include "sway/tree/view.h"
+
+struct cmd_results *cmd_background_blur(int argc, char **argv) {
+	struct cmd_results *error = checkarg(argc, "background_blur", EXPECTED_EQUAL_TO, 1);
+	if (error != NULL) {
+		return error;
+	}
+	bool enabled;
+	if (strcasecmp(argv[0], "enable") == 0) {
+		enabled = true;
+	} else if (strcasecmp(argv[0], "disable") == 0) {
+		enabled = false;
+	} else {
+		return cmd_results_new(CMD_INVALID, "Expected background_blur enable|disable");
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (con == NULL || con->view == NULL) {
+		return cmd_results_new(CMD_FAILURE, "Only application views support background_blur");
+	}
+	view_set_background_blur(con->view, enabled);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
