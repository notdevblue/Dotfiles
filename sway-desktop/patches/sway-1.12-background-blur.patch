+static void background_blur_update_node(struct wlr_scene_node *node,
+		struct sway_view *view) {
+	if (node->type == WLR_SCENE_NODE_BUFFER) {
+		struct wlr_scene_buffer *buffer = wlr_scene_buffer_from_node(node);
+		struct wlr_scene_surface *surface = wlr_scene_surface_try_from_buffer(buffer);
+		if (surface != NULL && surface->surface == view->surface) {
+			wlr_scene_buffer_set_background_blur(buffer, view->background_blur);
+		}
+	} else if (node->type == WLR_SCENE_NODE_TREE) {
+		struct wlr_scene_tree *tree = wlr_scene_tree_from_node(node);
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &tree->children, link) {
+			background_blur_update_node(child, view);
+		}
+	}
+}
+
+void view_set_background_blur(struct sway_view *view, bool enabled) {
+	view->background_blur = enabled;
+	// Traverse disabled nodes too: a resize transaction can temporarily hide
+	// the live tree in favor of a saved buffer.
+	background_blur_update_node(&view->content_tree->node, view);
+	if (view->saved_main_buffer != NULL) {
+		wlr_scene_buffer_set_background_blur(view->saved_main_buffer, enabled);
+	}
+}
